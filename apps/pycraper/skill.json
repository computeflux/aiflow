{
  "name": "x-scan",
  "version": "1.0.0",
  "description": "X 用户主页推文抓取：按 handle 抓取最新推文（复用 pycraper XAdapter 的浏览器抓取）",
  "owner": "workflow",
  "runtime": "python",
  "type": "service",
  "addr": "http://pycraper:9504",
  "image": "pycraper:latest",
  "entrypoint": "",
  "container": "",
  "input_schema": {
    "type": "object",
    "required": ["handle"],
    "properties": {
      "handle": {
        "type": "string",
        "minLength": 1,
        "description": "X 用户名（可带 @ 前缀）"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "最多抓取的推文数，默认 10"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "handle": {
        "type": "string"
      },
      "count": {
        "type": "integer"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "limits": {
    "timeout_sec": 300,
    "rate_per_min": 2,
    "max_concurrency": 1
  },
  "permissions": null
}
