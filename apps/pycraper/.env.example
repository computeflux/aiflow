# Temporal connection
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PYTHON_TASK_QUEUE=python-mcp-taskqueue

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=workflow
MYSQL_PASSWORD=
MYSQL_DATABASE=workflow

# GitHub - required for scraping commits
GITHUB_TOKEN=

# X (Twitter) - browser auth cookies for scraping
X_AUTH_TOKEN=
X_CT0=
# X proxy pool (comma-separated, e.g. "http://user:pass@host1:port,http://user:pass@host2:port")
# Empty = direct connection only. Recommended: 3+ rotating residential proxies.
PROXY_LIST=

# Xiaohongshu (小红书) - MCP server command (overrides mcp_command in config/xiaohongshu.json)
# 留空 = 使用 config/xiaohongshu.json 中的 mcp_command（'echo' 占位时抓取返回空、发布显式报错）
MCP_XHS_COMMAND=

# REDDIT
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# OpenAI-compatible API (for LLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Fast model for social generation (non-reasoning model fallback)
LLM_FAST_MODEL=
