{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    // 注：@wetee/web3auth 是 file: 源码依赖（main 指向 src/*.ts），
    // tsc 连带检查 SDK 源码时从该目录解析 react 找不到类型声明；
    // 故将 react 映射到本项目的 @types/react（vite 运行期解析不受影响）。
    "paths": {
      "@kit": ["./src/kit/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // 注：@wetee/web3auth 是 file: 源码依赖（main 指向 src/*.ts），其内部有未使用变量；
    // tsc 会连带检查 SDK 源码，故关闭 noUnused*（SDK 自身 lint 由其项目负责）。
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
