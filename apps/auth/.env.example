# auth — 统一权限认证服务 — 环境变量示例
# 与 config/config.go 的 env key 集合对齐。

# ---- 基础配置 ----
AUTH_HOST=0.0.0.0
AUTH_PORT=8008
# 数据库：AUTH_DB_DSN 优先；为空则用 MYSQL_*（根 .env 的 workflow 库）拼装
AUTH_DB_DSN=
#MYSQL_HOST=127.0.0.1
#MYSQL_PORT=3306
#MYSQL_USER=workflow
#MYSQL_PASSWORD=
#MYSQL_DATABASE=workflow

# ---- JWT（RS256）----
# 私钥文件（不存在时首次启动自动生成，0600，不落库）
AUTH_JWT_PRIVATE_KEY_PATH=auth_jwt.key
# kid 缺省由公钥指纹推导；轮换时换文件 + 显式指定新 kid（双公钥并存期下游按 kid 取）
AUTH_JWT_KID=
AUTH_ISSUER=https://auth.computeflux.ai
AUTH_AUDIENCE=workflow
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_SEC=2592000

# ---- 管理 ----
# 服务间管理操作凭证（X-Admin-Token 头）
AUTH_ADMIN_TOKEN=
# 首个管理员：该邮箱首次登录自动授 admin 角色
AUTH_ADMIN_EMAIL=

# ---- CORS（逗号分隔；留空则 *，不开 credentials）----
AUTH_CORS_ORIGINS=

# ---- SMTP（发 OTP 邮件；可复用根 .env 的 SMTP_*）----
#SMTP_HOST=smtp.example.com
#SMTP_PORT=465
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=

# ---- 社交登录 OAuth 凭据（缺省的 provider 不可用）----
# 注意：redirect_uri 由前端发起授权时决定（SDK 的 google/github/twitterRedirectUri），
# 后端交换 code 时由 SDK 回传，须与 IdP 控制台登记的回调一致。
#AUTH_GOOGLE_CLIENT_ID=
#AUTH_GOOGLE_CLIENT_SECRET=
#AUTH_GITHUB_CLIENT_ID=
#AUTH_GITHUB_CLIENT_SECRET=
#AUTH_X_CLIENT_ID=
#AUTH_X_CLIENT_SECRET=
