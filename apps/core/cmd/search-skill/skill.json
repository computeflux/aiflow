{
  "name": "search",
  "version": "1.0.0",
  "description": "知识向量检索：嵌入查询向量，从 Qdrant 集合检索最相关的文档 chunk（可限制最近天数）。",
  "owner": "workflow",
  "runtime": "go",
  "type": "service",
  "addr": "http://127.0.0.1:9503",
  "image": "workflow:search-skill",
  "input_schema": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": {
        "type": "string",
        "description": "检索查询"
      },
      "k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "返回结果数量，默认 5"
      },
      "days": {
        "type": "integer",
        "minimum": 0,
        "description": "仅检索最近 N 天的文档（0 表示不限）"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": { "type": "boolean" },
      "reason": { "type": "string" },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "chunk": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "content": { "type": "string" },
                "source": { "type": "string" },
                "url": { "type": "string" }
              }
            },
            "score": { "type": "number" }
          }
        }
      },
      "count": { "type": "integer" }
    }
  },
  "limits": {
    "timeout_sec": 60,
    "rate_per_min": 30,
    "max_concurrency": 4
  },
  "permissions": null
}
