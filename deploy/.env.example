# deploy/.env — compose 层变量（cp .env.example .env）
# 说明：
#   - 服务运行时配置（LLM 凭据、MySQL/Temporal 端点等）在**仓库根 .env**，
#     经各 compose 文件的 env_file 注入容器（端点一律容器名 DNS，
#     见 docs/plan/evolve-plan.md §3.3）。
#   - 本文件只承载 compose 文件内 ${VAR} 插值的基础设施凭据/参数。

# ---- MySQL（compose/infra/mysql.yml）----
MYSQL_ROOT_PASSWORD=workflow123
MYSQL_PASSWORD=workflow123
MYSQL_USER=workflow
MYSQL_DATABASE=workflow

# ---- Temporal（compose/infra/temporal-pg.yml / temporal.yml）----
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=temporal

# ---- Synapse（compose/infra/synapse.yml；S4 审批 Bot 注册用，必填）----
SYNAPSE_SERVER_NAME=dev-workflow.computeflux.ai
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me

# ---- social（compose/core/social.yml；小红书 MCP server 鉴权 Bearer Token，必填）----
# 注意：本文件是 compose ${VAR} 插值的来源（cd deploy && docker compose up 读 deploy/.env）；
# 仓库根 .env 只经 env_file 注入容器，不参与这里的插值。生产必填，勿用弱默认值。
SOCIAL_AUTH_TOKEN=change-me

# ---- ali-mcp（compose/core/ali-mcp.yml；淘宝/闲鱼 MCP server 鉴权 Bearer Token，必填）----
# 同 social：compose 插值来源，生产必填，勿用弱默认值。
ALI_MCP_AUTH_TOKEN=change-me

# ---- social-bilibili（compose/core/social-bilibili.yml；B站 MCP server 鉴权 Bearer Token，必填）----
# 非回环监听（容器 0.0.0.0:18666）必须配置，main.go 启动期强制校验，空则拒绝启动。
BILIBILI_AUTH_TOKEN=change-me

# ---- douyin-mcp（compose/core/social.yml；抖音 MCP server 鉴权 Bearer Token，必填）----
# 与 SOCIAL_AUTH_TOKEN 独立（两服务登录态/账号体系独立，token 不混用）。
# 约束：≥32 字符，仅允许字母/数字/._~-（douyin-mcp security.authToken 正则校验）。
# 生成示例：openssl rand -hex 32
DOUYIN_AUTH_TOKEN=change-me-to-a-random-32-plus-char-token