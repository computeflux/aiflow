# API
APP_HOST=0.0.0.0
APP_PORT=8000

# OTel（统一 compose 内服务：端点一律容器名 DNS）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# skill 网关地址（go-worker 的 InvokeSkill activity 调用；容器名 DNS）
SKILL_GATEWAY_URL=http://workflow-api:8001

# Temporal
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_GO_TASK_QUEUE=go-workflow-taskqueue
TEMPORAL_PYTHON_TASK_QUEUE=python-mcp-taskqueue
TEMPORAL_PYREPLAY_TASK_QUEUE=pyreplay-task-queue

# Qdrant
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=workflow_knowledge

# LLM（OpenAI 兼容端点；本项目当前用 bai 网关：llama.cpp 自部署，无需真 key）
# 例：OPENAI_BASE_URL=http://xiaobai.asyou.me:8009/v1  OPENAI_API_KEY=not-needed  LLM_MODEL=Qwen3.8-27B
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# MySQL (Python worker / social generator)
MYSQL_HOST=workflow-mysql
MYSQL_PORT=3306
MYSQL_USER=workflow
MYSQL_PASSWORD=workflow123
MYSQL_DATABASE=workflow

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# C2C 积分兑换平台 (apps/c2c, :8006)
C2C_HOST=0.0.0.0
C2C_PORT=8006
# AES-GCM 32 字节 base64（必填）: openssl rand -base64 32
C2C_KEY_ENCRYPTION_KEY=
# admin sub 名单（逗号分隔，Web3Auth sub）
C2C_ADMIN_SUBS=
# tee-node GraphQL（checkSession 鉴权）
C2C_TEE_NODE_URL=http://localhost:8080/graphql
# 支付通道 webhook secret
STRIPE_WEBHOOK_SECRET=
# 微信支付 V3（平台级商户号）
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_MERCHANT_SERIAL_NO=
WECHAT_MERCHANT_PRIVATE_KEY=
WECHAT_API_V3_KEY=
# 汇率 / 平台佣金 / 限额已迁移到 tee-chain 合约，由 c2c 通过 tee-node 读取；
# 治理在合约内设置（SetFxConfig），此处不再提供。仅保留超时 / 匹配默认值。
ORDER_TIMEOUT_SEC=900
MAX_MATCH_CANDIDATES=5

# S1 进化闭环（docs/plan/S1-进化闭环.md §5；验证灰度/过期时临时改小窗口/阈值）
AGENT_BINDING_CODER=pi
AGENT_BINDING_REVIEWER=ocr
# 进化 worktree 目录（相对仓库根：evolve-driver 容器内 /repo/<dir>，pi-web 容器内 /work/<dir>，同一宿主目录）
EVOLVE_CACHE_DIR=cache/evolve
EVOLVE_POLL_SEC=60
EVOLVE_BASE_BRANCH=main
# worktree 兜底清理周期（秒）：扫 cache/evolve/，对分支已合并进 main 且非进行中的目录
# 执行 git worktree remove + 删目录 + audit 留痕（合并成功路径已即时清理，此为漏网/历史遗留兜底；0 = 关闭）
EVOLVE_CLEAN_SCAN_SEC=1800
# 沙箱（安全参数写死在代码；dind 边车仓库挂载点见 compose/evolve/sandbox-dind.yml）
SANDBOX_ALLOWED_IMAGES=pycraper:*,pyreplay:*
# 白名单镜像是宿主本地镜像（dind 独立镜像库看不到）→ 默认走宿主 daemon；
# 改 registry 镜像后可切回 tcp://sandbox-dind:2375
SANDBOX_DOCKER_HOST=unix:///run/docker.sock
# bind 源前缀：走宿主 daemon 时 = 宿主仓库根绝对路径；切回 dind 时 = /work（dind 挂载点）
SANDBOX_REPO_PREFIX=/home/wetee/work/cathome/workflow
SANDBOX_RUNNER_URL=http://sandbox-runner:8123
SANDBOX_PORT=8123
# CI
CI_RUNNER_IMAGE=computeflux/ci-runner:latest
CI_CACHE_VOLUME=workflow_ci-cache
# 灰度自动化（每级一个窗口：时长或运行次数先到；恶化 → 自动回滚）
GRAY_STAGE_WINDOW_SEC=1800
GRAY_STAGE_MIN_RUNS=200
GRAY_FAIL_RATE=0.2
# 审批（24h 无人处理 → expired + 升级通知；不存在"默认通过"）
APPROVAL_EXPIRE_HOURS=24
# 审计巡检（30 分钟一轮，窗口 30 分钟）
AUDIT_INTERVAL_SEC=1800
AUDIT_WINDOW_SEC=1800
AUDIT_FAIL_RATE=0.2
AUDIT_MIN_RUNS=5
AUDIT_MIN_ERRORS=5
AUDIT_REPORT_DIR=/cache/audit
AUDIT_HEALTH_PORT=8120
# audit_logs 保留（天）：每日只 DROP 过期月分区，无删除 API
AUDIT_LOG_RETENTION_DAYS=180
# M4-1 会话保活巡检（工作项 wi-1795489658-2d59；挂在 audit 进程里，独立 ticker）：
# 轮询间隔（0 = 关闭保活）/ 覆盖渠道（逗号分隔）/ 掉线阈值（最近一次成功登录距今超过即判
# 会话失效，置 need_login + 告警）/ 单轮降级上限（探测链路自身故障时防止一轮打空整池账号）。
KEEPALIVE_INTERVAL_SEC=600
KEEPALIVE_CHANNELS=x
KEEPALIVE_STALE_SEC=259200
KEEPALIVE_MAX_DROPS_PER_TICK=50
# M4-1 跨服务切流护栏（x-scan / like → social；skill_cutover 行上的阈值优先于这里）：
# 相邻两档最短观察间隔 / 每档最少样本（成功率与一致率共用）/ 一致率与成功率阈值（严格大于）。
CUTOVER_MIN_STAGE_SEC=1800
CUTOVER_MIN_SAMPLES=20
CUTOVER_PARITY_MIN=0.9
CUTOVER_SUCCESS_MIN=0.95
# M4-1 旧服务下线：100% 全量收尾后的稳定观察窗（pycraper / pyreplay 缩容停服的硬前置）。
DECOMMISSION_STABLE_SEC=86400
# evolve-driver（仓库挂载 /repo；宿主 rootless docker socket）
REPO_DIR=/repo
EVOLVE_HEALTH_PORT=8121
DOCKER_HOST=unix:///run/docker.sock

# S4 协作底座（Matrix，docs/plan/S4-协作底座.md；MATRIX_ENABLED=true 启用 Matrix 通知，默认 no-op）
MATRIX_ENABLED=false
MATRIX_HOMESERVER=http://synapse:8008
MATRIX_BOT_USER=@approval-bot:dev-workflow.computeflux.ai
MATRIX_BOT_TOKEN=
MATRIX_ROOM_ALERTS=ops-alerts
MATRIX_ROOM_APPROVALS=approvals
MATRIX_ROOM_AGENT_LOG=agent-log
MATRIX_API_URL=http://workflow-api:8001
SYNAPSE_SERVER_NAME=dev-workflow.computeflux.ai

# S1 进化链写范围：小范围越界放行阈值（代码默认 2 文件/50 行；0 = 一律不准越界）
EVOLVE_SCOPE_ALLOW_FILES=2
EVOLVE_SCOPE_ALLOW_LINES=50
# reviewer 排除的生成产物：写在 apps/<app>/.aiflow 的 review_ignore（相对 app 目录，逗号分隔）。
# 通用生成物已内置在 apps/core/internal/agentcli/reviewignore.go，不用重复写。

# S1 人工 PR 自动化：审批通过后推 evolve/<task_no> 分支 + 建 GitHub PR（需 repo 权限 PAT；
# 未配置时跳过并留痕 pr_failed，可手动推分支建 PR）
GITHUB_TOKEN=
# 目标镜像构建器镜像（docker CLI + compose，用于从 worktree 构建 <app>:<version>）
EVOLVE_BUILDER_IMAGE=computeflux/deployctl:latest

# 发布跟进模式：local=released 后本地快进 main（默认，无需 token）；pr=推分支+建 GitHub PR；both=两者；off=人工
EVOLVE_MERGE_MODE=local

# 营销判断服务 mk-judge（:8131 仅内部网络，docs/marketing/plan/P2-判断服务地基.md MK-16/MK-17）
# 健康探针端口（代码默认 8131，与 compose healthcheck 一致）
MK_JUDGE_HEALTH_PORT=8131

# ai-flow（PicoClaw fork，apps/ai-flow，P1-5，:8134 仅内部网络）：
# workflow API 地址（容器内 DNS；ai-flow pkg/workflow 启动时读取并补齐到进程环境）
WORKFLOW_API_URL=http://workflow-api:8001
# ai-flow 运行时覆盖（apps/ai-flow/pkg/workflow/config.go，与 config.json 合并）：
# 网关端口（默认 8134）/ 模型别名 / provider / base_url / key / agent 工具轮次上限
# AIFLOW_PORT=8134
# AIFLOW_MODEL_NAME=
# AIFLOW_PROVIDER=openai
# AIFLOW_BASE_URL=
# AIFLOW_API_KEY=
# AIFLOW_MAX_TOOL_ITERATIONS=20
# P4-1：ai-flow 写操作两阶段确认 HMAC 密钥（apps/ai-flow pkg/workflow/approval.go）。
# confirm_token = HMAC-SHA256(secret, user_id|tool|params_hash|expire)，有效期 5min；
# 未配置时写工具 fail-closed 全部拒绝。生成：openssl rand -hex 32
# PICOCLAW_APPROVAL_SECRET=

